        <mxCell id="e12" value="creates / updates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#E7157B;dashed=1;" edge="1" parent="1" source="cfn" target="vpc">
