          <mxGeometry x="115" y="390" width="755" height="255" as="geometry" />
        </mxCell>
        <mxCell id="cfn" value="&lt;b&gt;CloudFormation + Git sync&lt;/b&gt;&lt;br&gt;template.yaml +&lt;br&gt;deployment.yaml" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudformation;fillColor=#E7157B;" vertex="1" parent="region">
          <mxGeometry x="1020" y="60" width="64" height="64" as="geometry" />
        </mxCell>
        <mxCell id="cw" value="&lt;b&gt;CloudWatch&lt;/b&gt;&lt;br&gt;1-min CPU metrics,&lt;br&gt;scaling alarms" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;fillColor=#E7157B;" vertex="1" parent="region">
          <mxGeometry x="1020" y="240" width="64" height="64" as="geometry" />
        </mxCell>
        <mxCell id="ssm" value="&lt;b&gt;Systems Manager&lt;/b&gt;&lt;br&gt;Session Manager&lt;br&gt;(no SSH, no open ports)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;fillColor=#E7157B;" vertex="1" parent="region">
          <mxGeometry x="1020" y="420" width="64" height="64" as="geometry" />
        </mxCell>
        <mxCell id="iam" value="&lt;b&gt;IAM role&lt;/b&gt;&lt;br&gt;AmazonSSMManagedInstanceCore&lt;br&gt;(managed policy, no inline)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;fillColor=#DD344C;" vertex="1" parent="region">
          <mxGeometry x="1020" y="600" width="64" height="64" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Traffic and change flow&lt;/b&gt;&lt;br&gt;&amp;#9312; Customers reach the ALB on HTTP :80 - the only public entry point.&lt;br&gt;&amp;#9313; ALB shares requests round robin across healthy servers in both AZs; /health every 15 s.&lt;br&gt;&amp;#9314; Servers have no public IP; the server security group admits :8080 from the ALB only.&lt;br&gt;&amp;#9315; Outbound only via the Regional NAT: security updates, Java, latest app release, SSM.&lt;br&gt;&amp;#9316; Average CPU above 50% &amp;#8594; Auto Scaling adds servers (max 6); below &amp;#8594; removes them (min 2).&lt;br&gt;&amp;#9317; A failed server or AZ is replaced automatically (ELB health checks).&lt;br&gt;&amp;#9318; Merge to main &amp;#8594; Git sync updates the stack; new servers install the latest app release.&lt;br&gt;&lt;i&gt;Tags on every resource: Project=onward · Owner=Jado Fils SEZIKEYE · Environment=dev&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="170" y="1100" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="resilience" value="&lt;b&gt;If one part fails, the service keeps running&lt;/b&gt;&lt;br&gt;&lt;b&gt;Server dies / app hangs&lt;/b&gt; &amp;#8594; 3 failed /health checks, ALB stops routing, Auto Scaling replaces it.&lt;br&gt;&lt;b&gt;Availability Zone lost&lt;/b&gt; &amp;#8594; ALB, Regional NAT and servers also run in the other AZ; replacements launch there.&lt;br&gt;&lt;b&gt;Sales-day surge&lt;/b&gt; &amp;#8594; CPU &amp;gt; 50% adds servers (max 6); busy servers are not mistaken for failed ones.&lt;br&gt;&lt;b&gt;Server fails to boot&lt;/b&gt; &amp;#8594; cfn-signal holds the stack until the app answers; 2 servers stay in service." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="950" y="1100" width="480" height="170" as="geometry" />
        </mxCell>
